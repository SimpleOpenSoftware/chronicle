# TTS Services Configuration
# Copy this file to .env and configure as needed

# =============================================================================
# HuggingFace Token (Required)
# =============================================================================
# TADA uses Llama 3.2 as its base model, which is gated on HuggingFace.
# You must accept the Llama 3.2 license at https://huggingface.co/meta-llama/Llama-3.2-1B
# and provide your HF token here.
HF_TOKEN=

# =============================================================================
# Model Configuration
# =============================================================================
# Model identifier (HuggingFace repo)
#
# TADA models:
#   - HumeAI/tada-1b (English, ~4-5GB VRAM, default)
#   - HumeAI/tada-3b-ml (Multilingual: ar, zh, de, es, fr, it, ja, pl, pt, ~7-8GB VRAM)
#
# Fish Speech models:
#   - fishaudio/s2-pro (default, 83 languages, ~11GB, CC-BY-NC-SA)
#   - fishaudio/openaudio-s1-mini (0.5B, 50+ languages, ~6GB VRAM, needs tokenizer workarounds)
#   - fishaudio/fish-speech-1.5 (larger, higher quality, Research License)
#
TTS_MODEL=HumeAI/tada-1b

# =============================================================================
# Service Port Configuration
# =============================================================================
TTS_PORT=8770

# =============================================================================
# PyTorch/CUDA Configuration
# =============================================================================
# Options: cu126 (CUDA 12.6), cu128 (CUDA 12.8)
# Note: cu121 not supported (hume-tada requires torch>=2.7 which needs CUDA 12.6+)
PYTORCH_CUDA_VERSION=cu126

# =============================================================================
# TADA Provider Settings
# =============================================================================
# Language for multilingual model (only needed for tada-3b-ml)
# Options: ar, zh, de, es, fr, it, ja, pl, pt (empty for English)
TTS_LANGUAGE=

# =============================================================================
# Fish Speech Provider Settings
# =============================================================================
# Enable torch.compile for ~10x speedup (requires longer first-inference warmup)
TTS_COMPILE=false
# Use half precision (default: true, reduces VRAM usage)
TTS_HALF=true

# =============================================================================
# KittenTTS Provider Settings (CPU-only, no GPU / HF token required)
# =============================================================================
# KittenTTS uses dedicated KITTEN_TTS_* vars so the heavy Fish/TADA settings
# above don't bleed into this lightweight CPU service.
#
# Models:
#   - KittenML/kitten-tts-mini-0.8 (default)
#   - KittenML/kitten-tts-micro-0.8 (~41MB)
#   - KittenML/kitten-tts-nano-0.8-int8 (~25MB)
KITTEN_TTS_MODEL=KittenML/kitten-tts-mini-0.8
# Preset voice: Bella, Jasper, Luna, Bruno, Rosie, Hugo, Kiki, Leo
KITTEN_TTS_VOICE=Jasper
# Speech speed multiplier
KITTEN_TTS_SPEED=1.0
# Service port
KITTEN_TTS_PORT=8770

# Kokoro uses dedicated settings. CPU mode avoids sharing GPU execution with
# a concurrently generating LLM; speech speed remains independently configured.
KOKORO_TTS_MODEL=hexgrad/Kokoro-82M
KOKORO_TTS_VOICE=af_heart
KOKORO_TTS_LANG_CODE=a
KOKORO_TTS_SPEED=1.0
KOKORO_TTS_PORT=8770
KOKORO_TTS_DEVICE=auto
KOKORO_TTS_CPU_THREADS=4
