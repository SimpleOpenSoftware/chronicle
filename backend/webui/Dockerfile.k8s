# Production WebUI image for the Kubernetes (Skaffold) deployment.
# Build context is the repository root, because package.json depends on
# ../../contracts/audio/v2/typescript. Local development uses Dockerfile.dev.
FROM node:22-alpine AS build

WORKDIR /workspace/backend/webui

COPY contracts/audio/v2/typescript /workspace/contracts/audio/v2/typescript

COPY backend/webui/package.json ./package.json
COPY backend/webui/package-lock.json ./package-lock.json
RUN npm ci

COPY backend/webui/ .

ARG VITE_BACKEND_URL
ENV VITE_BACKEND_URL=${VITE_BACKEND_URL}

RUN npm run build

FROM nginx:alpine AS production

COPY backend/webui/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /workspace/backend/webui/dist /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
