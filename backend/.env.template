# ========================================
# Chronicle Backend - Secrets Only
# ========================================
# This file contains ONLY secret values (API keys, passwords, tokens).
# All other configuration is in config/config.yml.
#
# Setup:
# 1. Copy this file to .env: cp .env.template .env
# 2. Fill in your API keys and secrets below
# 3. Configure non-secret settings in config/config.yml
# 4. Run: docker compose up --build -d

# ========================================
# Authentication Secrets
# ========================================

# JWT signing key (generate a long random string)
AUTH_SECRET_KEY=

# Admin account password
ADMIN_PASSWORD=

# Admin email address
ADMIN_EMAIL=admin@example.com

# ========================================
# LLM API Keys
# ========================================

# OpenAI API key (or OpenAI-compatible provider)
OPENAI_API_KEY=

# ========================================
# Transcription API Keys
# ========================================

# Deepgram API key (for cloud-based transcription)
DEEPGRAM_API_KEY=

# Smallest.ai API key (for Pulse STT)
# SMALLEST_API_KEY=

# ========================================
# Speaker Recognition
# ========================================

# Hugging Face token (for PyAnnote speaker recognition models)
HF_TOKEN=

# ========================================
# Optional Services
# ========================================

# FalkorDB configuration (if using FalkorDB for Obsidian or Knowledge Graph)
FALKORDB_HOST=falkordb
FALKORDB_PORT=6379

# Langfuse (for LLM observability and prompt management)
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=http://langfuse-web:3000
# Chronicle's manual Pi/Codex/tool memory spans are metadata-only by default. Enable
# only for a trusted local Langfuse; captured content is bounded but still personal.
LANGFUSE_MEMORY_CAPTURE_CONTENT=false
# Direct uses the globally instrumented OpenAI client. To redact its native child-span
# payloads too, enable both global OpenInference controls below (affects every OpenAI
# call in Chronicle, not only memory):
# OPENINFERENCE_HIDE_INPUTS=true
# OPENINFERENCE_HIDE_OUTPUTS=true

# Galileo (OTEL-based LLM observability)
GALILEO_API_KEY=
GALILEO_PROJECT=chronicle
GALILEO_LOG_STREAM=default
# GALILEO_CONSOLE_URL=https://app.galileo.ai  # Default; override for self-hosted

# Qwen3-ASR (offline ASR via vLLM)
# QWEN3_ASR_URL=host.docker.internal:8767
# QWEN3_ASR_STREAM_URL=host.docker.internal:8769

# Tailscale auth key (for remote service access)
TS_AUTHKEY=

# Immich photo library integration. Timeline reads Immich only when a user asks
# to reconcile a day; person photos may still be embedded into vault People notes.
# IMMICH_USER_ID is the Chronicle user ObjectId that owns imported references;
# leave it empty to use the admin account.
IMMICH_URL=
IMMICH_API_KEY=
IMMICH_USER_ID=

# Expo push access token. Enable push security in the Expo project before setting
# this backend-only secret; never place it in app.json or the mobile bundle.
EXPO_ACCESS_TOKEN=

# Home Assistant plugin (voice-command smart home control). HA_TOKEN is a
# long-lived access token (HA → Profile → Security). The wizard can discover
# the server on the Tailnet; enable the plugin in config/plugins.yml.
HA_URL=
HA_TOKEN=

# Swiggy Instamart interaction mode. Link exactly one Chronicle user and copy
# tokens.json + client.json from the standalone MCP workspace into this private,
# persistent container path before enabling swiggy_instamart in plugins.yml.
SWIGGY_LINKED_USER_ID=
SWIGGY_TOKEN_DIRECTORY=/app/data/integrations/swiggy

# --- Vault Sync (Syncthing) ---------------------------------------------------
# Shares your Obsidian vault (data/conversation_docs/{user_id}) with your Mac so you
# can open it in Obsidian. Enable with: docker compose --profile vault-sync up -d
# API key the backend uses to drive the server Syncthing (any long random string).
VAULT_SYNC_API_KEY=
# Address your Mac dials to reach this server's Syncthing, host:port on port 22000.
# Usually your backend's Tailscale name, e.g. tcp://my-host.ts.net:22000
# Leave empty to rely on Syncthing's own discovery/relays.
VAULT_SYNC_ADDRESS=
# Match the owner of data/conversation_docs so Syncthing can read/write it (0 = root).
# VAULT_SYNC_PUID=0
# VAULT_SYNC_PGID=0

# --- Service Manager (start/stop services from the WebUI) ---------------------
# Host-side agent (edge/service_manager.py) that the System page uses to
# start/stop/restart services and switch ASR/TTS providers. Started
# automatically by ./start.sh; the token is auto-generated on first start.
# Only set the URL if the agent runs on a different machine (distributed setup).
# SERVICE_MANAGER_URL=http://host.docker.internal:8775
# SERVICE_MANAGER_TOKEN=

# --- Cross-service error reporting (System Errors page) -----------------------
# Sidecar services (ASR, speaker-recognition) can POST their ERROR/CRITICAL logs
# to POST /api/admin/system-events/ingest so they appear on the admin "System
# Errors" page. That endpoint is gated by a shared token. By default it reuses
# SERVICE_MANAGER_TOKEN above; set this only to use a dedicated secret. The same
# value goes in each service's CHRONICLE_INGEST_TOKEN.
# SYSTEM_EVENT_INGEST_TOKEN=

# Managed compute gateway (used only by models/speaker with a deployment reference).
# Both point to the deployment authority, which may differ from this node's manager.
# SERVICE_GATEWAY_URL=http://host.docker.internal:8775
# SERVICE_GATEWAY_TOKEN=<authority SERVICE_MANAGER_TOKEN>
# Shared fleet control credential for enrolled node agents and lifecycle CLI.
# SERVICE_PLACEMENT_TOKEN=<shared secret on all enrolled nodes>

# Managed speech synthesis; leave direct TTS URL overrides unset.
TTS_DEPLOYMENT=
