# Pi 0.85 requires Node >=22.19. Keep these versions the same as backend/Dockerfile.
ARG NODE_VERSION=22.19.0

FROM node:${NODE_VERSION}-bookworm-slim AS pi-fetcher
ARG PI_VERSION=0.85.1
RUN npm install --global --prefix /opt/pi --omit=dev --ignore-scripts --no-audit --no-fund \
      "@earendil-works/pi-coding-agent@${PI_VERSION}" \
    && npm cache clean --force

FROM python:3.12-slim-bookworm AS builder

# Install system dependencies for building
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    build-essential \
    libsndfile1 \
    git \
    curl \
    ffmpeg \
    ripgrep \
    && rm -rf /var/lib/apt/lists/*
    # portaudio19-dev \

# Install uv
COPY --from=ghcr.io/astral-sh/uv:0.6.10 /uv /uvx /bin/

# Pi runs Timeline analysis. Node is its runtime; npm is not needed at runtime.
COPY --from=pi-fetcher /usr/local/bin/node /usr/local/bin/node
COPY --from=pi-fetcher /opt/pi /opt/pi

# Set up the working directory
WORKDIR /app

# Copy package structure and dependency files first
COPY pyproject.toml README.md ./
COPY uv.lock .
RUN mkdir -p src/backend
COPY src/backend/__init__.py src/backend/

# Install dependencies using uv
# Use cache mount for BuildKit, fallback for legacy builds
# RUN --mount=type=cache,target=/root/.cache/uv \
#     uv sync
# Fallback for legacy Docker builds (CI compatibility)
RUN uv sync

# Copy all application code
COPY . .

# Copy memory config (created by init.sh from template)


# Copy and make K8s startup script executable
COPY start-k8s.sh ./
RUN chmod +x start-k8s.sh

# Activate virtual environment in PATH
ENV PATH="/app/.venv/bin:/opt/pi/bin:$PATH"

# Run the application with workers
# K8s startup script starts both FastAPI backend and RQ workers
CMD ["./start-k8s.sh"]
