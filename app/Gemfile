# Gemfile for Fastlane iOS automation
source "https://rubygems.org"

gem "fastlane", "~> 2.220"

# Must be in the Gemfile so `bundle exec pod install` (used by Fastlane) finds `pod`
gem "cocoapods", "~> 1.16"

plugins_path = File.join(File.dirname(__FILE__), 'fastlane', 'Pluginfile')
eval_gemfile(plugins_path) if File.exist?(plugins_path)
